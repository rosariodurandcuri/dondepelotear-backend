# Conexión a PostgreSQL (la misma que usa docker-compose.yml)
DATABASE_URL="postgresql://canchaya:canchaya@localhost:5432/canchaya?schema=public"

# Clave para firmar los tokens de sesión (cámbiala en producción)
JWT_SECRET="cambia-esta-clave-por-una-larga-y-secreta"

# Puerto de la API
PORT=3000

# Orígenes permitidos para el frontend (separados por coma). Vacío = todos.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Zona horaria del negocio (fechas "hoy", horarios pasados, etc.)
TZ="America/Lima"
